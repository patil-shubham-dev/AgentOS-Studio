{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/cli",
    "rootDir": "src/cli",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@agentic-os/providers": ["./packages/providers/src/index.ts"],
      "@agentic-os/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["src/cli/**/*.ts"],
  "exclude": ["node_modules"]
}
