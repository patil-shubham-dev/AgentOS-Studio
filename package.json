{
  "name": "agenticos",
  "private": true,
  "version": "3.0.0",
  "description": "AgenticOS — Your AI operating system for development",
  "author": "AgenticOS (https://agenticos.ai)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "electron-vite dev --renderer",
    "build": "tsc --noEmit && electron-vite build && node scripts/verify-build.mjs",
    "verify-build": "node scripts/verify-build.mjs",
    "preview": "electron-vite preview",
    "start": "electron .",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js apps/desktop/src/renderer --ext .ts,.tsx",
    "lint:renderer": "node --max-old-space-size=2048 ./node_modules/eslint/bin/eslint.js apps/desktop/src/renderer --ext .ts,.tsx",
    "lint:main": "node --max-old-space-size=2048 ./node_modules/eslint/bin/eslint.js apps/desktop/src/main --ext .ts",
    "lint:packages": "node --max-old-space-size=2048 ./node_modules/eslint/bin/eslint.js packages --ext .ts,.tsx",
    "lint:changed": "node scripts/lint-changed.mjs",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-clean-worktree.mjs && vitest run --exclude \"**/RealProviderStreaming.verify.test.ts\" --exclude \"**/OpencodeAdapter.verify.test.ts\" --exclude \"**/ProductionHardening.test.ts\" --exclude \"**/MemoryLeakMeasurementV2.test.ts\" --exclude \"**/benchmarks.test.ts\" --exclude \"**/PerformanceRegression.test.ts\" --exclude \"**/provider-streaming-stress.test.ts\"",
    "test:unit": "vitest run --exclude \"**/RealProviderStreaming.verify.test.ts\" --exclude \"**/OpencodeAdapter.verify.test.ts\" --exclude \"**/ProductionHardening.test.ts\" --exclude \"**/MemoryLeakMeasurementV2.test.ts\" --exclude \"**/benchmarks.test.ts\" --exclude \"**/PerformanceRegression.test.ts\" --exclude \"**/provider-streaming-stress.test.ts\"",
    "test:harness": "vitest run apps/desktop/src/main/harness/OpencodeAdapter.verify.test.ts",
    "test:stress": "vitest run \"**/ProductionHardening.test.ts\" \"**/MemoryLeakMeasurementV2.test.ts\" \"**/provider-streaming-stress.test.ts\"",
    "test:provider": "vitest run apps/desktop/src/renderer/runtime/tests/RealProviderStreaming.verify.test.ts",
    "test:benchmark": "vitest run \"**/PerformanceRegression.test.ts\" \"**/benchmarks.test.ts\"",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --config config/electron-builder.config.cjs --dir",
    "dist": "electron-vite build && electron-builder --config config/electron-builder.config.cjs",
    "dist:win": "electron-vite build && electron-builder --config config/electron-builder.config.cjs --win",
    "dist:mac": "electron-vite build && electron-builder --config config/electron-builder.config.cjs --mac",
    "dist:linux": "electron-vite build && electron-builder --config config/electron-builder.config.cjs --linux",
    "release": "electron-vite build && electron-builder --config config/electron-builder.config.cjs --win --mac --linux --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/sdk": "1.18.18",
    "@pierre/trees": "^1.0.0-beta.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.59.0",
    "@sentry/react": "^10.59.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "electron-updater": "^6.8.0",
    "form-data": "^4.0.6",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.25",
    "js-yaml": "^5.1.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tiktoken": "^1.0.22",
    "zod": "^3.23.8",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.11"
    }
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.0.0",
    "png-to-ico": "^3.0.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.6"
  }
}
